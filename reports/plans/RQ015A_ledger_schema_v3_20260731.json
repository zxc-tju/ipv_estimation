      "uniform_fallback_error_K5": 0.5527864045000421,
      "note": "占位（从未求解）与均匀回退（求解了但权重摊平）是两件事，不得混为一谈"
    },
    "empty_cell_rule": {
      "empty_and_in_d0": {
        "attempt_status": "NOT_ATTEMPTED",
        "reason_code": "D0_WARMUP"
      },
      "empty_and_past_d0": {
        "attempt_status": "UNKNOWN",
        "reason_code": "EMPTY_CELL_UNEXPLAINED"
      },
      "forbidden": "把空串读作 0"
    }
